# API Configuration
# URL of your backend API, default is http://localhost:8080 if not specified
NEXT_PUBLIC_API_URL=http://localhost:8080

# For server-side fetching of association settings (used in app/layout.tsx)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Optional system token for server-side API calls (used in lib/server-utils.ts)
# This allows fetching association settings even when no user is logged in
# SYSTEM_API_TOKEN=your_backend_system_token_here

# Node environment - development, production, or test
NODE_ENV=development
